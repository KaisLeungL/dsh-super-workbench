{
  "compilerOptions": {
    "target": "ES2024",
    "lib": [
      "ES2023",
      "DOM"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react",
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "lib/types",
    "rootDir": "src",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "types": [
      "node",
      "react"
    ]
  },
  "include": [
    "src"
  ]
}
